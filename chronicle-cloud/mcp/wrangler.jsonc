  "name": "chronicle-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "SUPABASE_URL": "https://cqrgdtnvmgnimzxyaiih.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_yrCOIzmQmdxxicUpwRiatQ_9iqqAsuK",
