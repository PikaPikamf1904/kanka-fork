// Chronicle MCP Worker. Nothing here is a secret: the publishable key is the same public key the
// website ships to every browser. There is NO Supabase secret or service-role key in this Worker;
// every database call uses the signed-in caller's own token, so Row Level Security applies.
{
  "name": "chronicle-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Every request is logged (the volume is tiny next to the free 0.5 GB/day from 1 Dec 2026), but
  // query strings are redacted so no code or token in an address can end up in the logs.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": true }, "redact_query_string": true },
  "vars": {
    "SUPABASE_URL": "https://cqrgdtnvmgnimzxyaiih.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_yrCOIzmQmdxxicUpwRiatQ_9iqqAsuK",
    "CHRONICLE_URL": "https://chronicle-wiki-preview.pages.dev"
  }
}
