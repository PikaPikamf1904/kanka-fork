// Example only. Copy to wrangler.jsonc when the DM approves a deployment; nothing here is a secret.
// The publishable key is the same public key the website uses. There is NO secret key in this Worker.
{
  "name": "chronicle-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://<project-ref>.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "<publishable key>",
    "CHRONICLE_URL": "https://<your-site>.pages.dev"
  }
}
