# Build-time (browser). The publishable key is designed to be public; RLS protects all data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Cloudflare Pages Function (/api/enroll). Set these in the Pages dashboard as secrets.
# For `wrangler pages dev`, put them in .dev.vars (gitignored). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
IP_HASH_SECRET=REPLACE_WITH_32_RANDOM_CHARACTERS
# TURNSTILE_SECRET_KEY=   (leave unset: the access screen does not send a Turnstile token yet)
