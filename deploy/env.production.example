# Production .env template for Big Bertha (single Debian machine on the home LAN).
# provision.sh copies this to /srv/kanka/shared/.env and fills in APP_KEY, APP_URL,
# DB_PASSWORD and BACKUP_ARCHIVE_PASSWORD with generated values.
# Never commit the real file: this repository is public.

APP_NAME="Kanka"
APP_ENV=production
APP_KEY=CHANGE_ME_generated_by_provision
APP_DEBUG=false
# The address you type on your tablet, e.g. http://192.168.1.239 (set by provision.sh).
APP_URL=http://CHANGE_ME
# Shown as the sender/contact address; any address you own.
APP_EMAIL=CHANGE_ME@example.com
# Leave false for plain HTTP on the LAN. Set true only behind an HTTPS proxy you set up
# yourself (see "Remote access" in deploy/README.md), together with an https APP_URL.
APP_FORCE_HTTPS=false
APP_IGNORE_DEVELOP_WARNING=true
# Turn off once your players have registered.
APP_REGISTRATION_ENABLED=true
# While sign-up is on, people must also type this invite code (give it to your players).
# Leave empty to let anyone who can reach the site sign up. Signing up through
# Google/Facebook/X is refused while a code is set.
APP_REGISTRATION_CODE=
# Do not run kanka.io subscription, onboarding-email and report jobs.
APP_SAAS_SCHEDULE=false

# One log file per day, kept for 7 days, in /srv/kanka/shared/storage/logs.
LOG_CHANNEL=daily

# MariaDB on the same machine, reached through its local socket only.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/run/mysqld/mysqld.sock
DB_PORT=3306
DB_DATABASE=kanka
DB_USERNAME=kanka
DB_PASSWORD=CHANGE_ME
# There is no separate read replica or logs database.
DB_REPLICA_ENABLED=false
# MariaDB's dump tool does not accept --column-statistics.
DB_BINARY_DUMP_PATH=/usr/bin/
DB_BINARY_DUMP_OPTIONS="--single-transaction --skip-lock-tables"

# No Redis: cache, sessions and both queues live in files and MariaDB.
CACHE_DRIVER=file
SESSION_DRIVER=file
# Plain HTTP on the LAN: secure-only cookies would make logging in impossible.
SESSION_SECURE_COOKIE=false
QUEUE_DRIVER=database
# Map tiling, exports and imports run on their own worker (kanka-queue-heavy).
QUEUE_HEAVY_DRIVER=database
BROADCAST_DRIVER=null
SCOUT_DRIVER=null

# Uploads on local disk (served by the permission-checked /storage application route);
# exports and imports stay outside the web root and use permission-checked routes too.
FILESYSTEM_DRIVER=public
S3_DISK_DRIVER=local
# Empty key = no Thumbor; original images are served directly.
THUMBOR_KEY=

# Only a local HTTPS proxy (if you add one) may set forwarded headers.
TRUSTED_PROXIES=127.0.0.1

# Backups: database + uploads, encrypted, twice a day, in /srv/kanka/backups.
# Copy them to another computer regularly (deploy/README.md, "Backups").
# Store BACKUP_ARCHIVE_PASSWORD in your password manager: without it the archives
# cannot be opened.
BACKUP_DISK=backups
BACKUP_ROOT=/srv/kanka/backups
BACKUP_INCLUDE_UPLOADS=true
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=14
BACKUP_KEEP_MONTHLY_MONTHS=6
# Stop growing past ~100 GB of the 500 GB disk.
BACKUP_MAX_MEGABYTES=100000

# Email is off by default (messages go to the log). Password-reset emails need SMTP;
# see "Email" in deploy/README.md.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=CHANGE_ME@example.com
MAIL_FROM_NAME="${APP_NAME}"
