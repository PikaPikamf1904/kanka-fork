# Production .env template for the single-VM deployment (see deploy/README.md).
# Copy to /srv/kanka/shared/.env on the server and fill in every CHANGE_ME.
# Never commit the real file.

APP_NAME="Kanka"
APP_ENV=production
APP_KEY=CHANGE_ME_run_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://CHANGE_ME.ts.net
APP_EMAIL=CHANGE_ME@example.com
APP_FORCE_HTTPS=false
APP_IGNORE_DEVELOP_WARNING=true
# Turn off after your players have registered.
APP_REGISTRATION_ENABLED=true
# Do not run kanka.io subscription, onboarding-email and report jobs.
APP_SAAS_SCHEDULE=false

LOG_CHANNEL=daily

# MariaDB on the same machine, reached through its local socket.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/run/mysqld/mysqld.sock
DB_PORT=3306
DB_DATABASE=kanka
DB_USERNAME=kanka
DB_PASSWORD=CHANGE_ME
# There is no separate read replica or logs database.
DB_REPLICA_ENABLED=false
# MariaDB's dump tool does not accept --column-statistics.
DB_BINARY_DUMP_PATH=/usr/bin/
DB_BINARY_DUMP_OPTIONS="--single-transaction --skip-lock-tables"

# No Redis: cache, sessions and queue live in files and MariaDB.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
QUEUE_DRIVER=database
BROADCAST_DRIVER=null
SCOUT_DRIVER=null

# Uploads on local disk (served from /storage), exports/imports outside the web root.
FILESYSTEM_DRIVER=public
S3_DISK_DRIVER=local
# Empty key = no Thumbor; original images are served directly.
THUMBOR_KEY=

# Requests only arrive from the local Tailscale Funnel proxy.
TRUSTED_PROXIES=127.0.0.1

# Backups (database + uploads), encrypted, kept on the server's disk.
# To copy them off the server, see "Backups" in deploy/README.md.
BACKUP_DISK=local
BACKUP_INCLUDE_UPLOADS=true
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME

# Email is off by default (messages go to the log). Password-reset emails need SMTP;
# see "Email" in deploy/README.md for a free option.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=CHANGE_ME@example.com
MAIL_FROM_NAME="${APP_NAME}"
